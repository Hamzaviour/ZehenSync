{"nodes": [{"id": "docs_07_clinical_safety_protocol", "label": "Safety Protocol", "file_type": "document", "source_file": "docs/07-Clinical/Safety-Protocol.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Binding on every developer: if code and this page disagree, the code is wrong."}, {"id": "docs_07_clinical_safety_protocol_safety_pathway", "label": "Safety pathway (moderate risk response)", "file_type": "concept", "source_file": "docs/07-Clinical/Safety-Protocol.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moderate signals (PHQ-9 item 9 = 1 or 2, classifier distress > 0.8, C-SSRS Q1/Q2 yes) pause the instrument, run the C-SSRS screener, pin a resources strip, raise an urgent flag and switch the counselor to a safety-focused prompt."}, {"id": "docs_07_clinical_safety_protocol_hard_stop", "label": "Hard Stop (high risk response)", "file_type": "concept", "source_file": "docs/07-Clinical/Safety-Protocol.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "High signals abort or skip the LLM call, show a full-screen crisis view with no AI text, write crisis_event, raise a crisis flag, alert the linked psychologist within 60 s and lock the session."}, {"id": "docs_07_clinical_safety_protocol_higher_response_wins", "label": "Higher response wins (accept false positives)", "file_type": "rationale", "source_file": "docs/07-Clinical/Safety-Protocol.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When detectors disagree the higher response wins; a missed crisis costs far more than an interrupted chat."}, {"id": "docs_07_clinical_safety_protocol_crisis_lexicon", "label": "Crisis lexicon (packages/crisis-lexicon)", "file_type": "concept", "source_file": "docs/07-Clinical/Safety-Protocol.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Versioned, clinician-reviewed each release; classes imminent, self_harm, suicidal_ideation, harm_to_others, psychosis_distress; English and Roman Urdu spellings."}, {"id": "docs_07_clinical_safety_protocol_lexicon_normalisation", "label": "Lexicon normalisation", "file_type": "concept", "source_file": "docs/07-Clinical/Safety-Protocol.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_07_clinical_safety_protocol_negation_window", "label": "3-token negation window", "file_type": "concept", "source_file": "docs/07-Clinical/Safety-Protocol.md", "source_location": "L30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lowers suicidal_ideation to distress for negated phrases but never lowers imminent."}, {"id": "docs_07_clinical_safety_protocol_distilroberta_classifier", "label": "DistilRoBERTa risk classifier", "file_type": "concept", "source_file": "docs/07-Clinical/Safety-Protocol.md", "source_location": "L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads current message plus two previous user messages so multi-turn signals still fire; thresholds live in config and change only with a passing eval run."}, {"id": "docs_07_clinical_safety_protocol_instrument_risk_rules", "label": "Instrument risk_rules", "file_type": "concept", "source_file": "docs/07-Clinical/Safety-Protocol.md", "source_location": "L39", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_07_clinical_safety_protocol_get_help_now", "label": "\"Get help now\" manual trigger", "file_type": "concept", "source_file": "docs/07-Clinical/Safety-Protocol.md", "source_location": "L46", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_07_clinical_safety_protocol_crisis_event", "label": "crisis_event record", "file_type": "concept", "source_file": "docs/07-Clinical/Safety-Protocol.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_07_clinical_safety_protocol_crisis_screen", "label": "Crisis screen", "file_type": "concept", "source_file": "docs/07-Clinical/Safety-Protocol.md", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No AI-generated text, no animation beyond a 150 ms fade, no red or alarm styling."}, {"id": "docs_07_clinical_safety_protocol_resources_strip", "label": "Resources strip", "file_type": "concept", "source_file": "docs/07-Clinical/Safety-Protocol.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_07_clinical_safety_protocol_crisis_resources_ts", "label": "apps/web/lib/crisis/resources.ts", "file_type": "concept", "source_file": "docs/07-Clinical/Safety-Protocol.md", "source_location": "L67", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_07_clinical_safety_protocol_umang_pakistan", "label": "Umang Pakistan helpline (0311 7786264)", "file_type": "concept", "source_file": "docs/07-Clinical/Safety-Protocol.md", "source_location": "L55", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_07_clinical_safety_protocol_rozan_helpline", "label": "Rozan Counseling Helpline (0304 111 1741)", "file_type": "concept", "source_file": "docs/07-Clinical/Safety-Protocol.md", "source_location": "L56", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_07_clinical_safety_protocol_rescue_1122", "label": "Rescue 1122 emergency", "file_type": "concept", "source_file": "docs/07-Clinical/Safety-Protocol.md", "source_location": "L57", "source_url": null, "captured_at": null, "aut