 "source_location": "L77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Response style for delusions or hallucinations: neither argue with, confirm nor explore the content; acknowledge fear and point to a professional."}, {"id": "docs_07_clinical_safety_protocol_psychologist_alert", "label": "Psychologist alert", "file_type": "concept", "source_file": "docs/07-Clinical/Safety-Protocol.md", "source_location": "L82", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In-app plus email for FYP (SMS later); pseudonym unless identity scope; no transcript text in email."}, {"id": "docs_07_clinical_safety_protocol_admin_safety_dashboard", "label": "Admin safety dashboard", "file_type": "concept", "source_file": "docs/07-Clinical/Safety-Protocol.md", "source_location": "L86", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_07_clinical_safety_protocol_golden_crisis_set", "label": "Golden crisis set (300+ phrases, 40% Roman Urdu)", "file_type": "concept", "source_file": "docs/07-Clinical/Safety-Protocol.md", "source_location": "L90", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Target recall 100%, including indirect phrasing."}, {"id": "docs_07_clinical_safety_protocol_benign_set", "label": "Benign set (500+ phrases, idioms and lyrics)", "file_type": "concept", "source_file": "docs/07-Clinical/Safety-Protocol.md", "source_location": "L91", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Target false-positive rate under 5%."}, {"id": "docs_07_clinical_safety_protocol_playwright_crisis_e2e", "label": "Playwright crisis E2E test", "file_type": "concept", "source_file": "docs/07-Clinical/Safety-Protocol.md", "source_location": "L92", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_07_clinical_safety_protocol_ci_safety