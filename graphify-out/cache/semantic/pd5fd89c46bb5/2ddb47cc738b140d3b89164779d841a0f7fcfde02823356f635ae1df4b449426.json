{"nodes": [{"id": "docs_04_brand_brand_kit", "label": "Brand Kit (v2)", "file_type": "document", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single source for ZehenSync brand v2: idea, logo, colour, type, icons, pattern, motion, voice and an anti-slop checklist. Status v2, updated 2026-09-28."}, {"id": "docs_04_brand_brand_kit_light_clinical_editorial", "label": "Light clinical editorial direction", "file_type": "rationale", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "v2 direction replacing the v1 Sync Z identity: the product is light and calm; brand moments (decks, posters, social) go dark."}, {"id": "docs_04_brand_brand_kit_sync_z_identity", "label": "Sync Z identity (v1, superseded)", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_06_memory_decisions_adr_015", "label": "ADR-015 Brand v2 (Zaal mark)", "file_type": "document", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_03_design_design_system", "label": "Design-System", "file_type": "document", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_00_home_rules", "label": "Rules (Design and writing)", "file_type": "document", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_tokens", "label": "tokens.css", "file_type": "code", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_brand_kit_nuqta_idea", "label": "The nuqta idea (dal to zaal)", "file_type": "rationale", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In Urdu one nuqta turns dal into zaal, the first letter of zehen (mind); calligraphers measure letters in nuqtas. ZehenSync works the same way: every score, flag and citation sits on a point a psychologist can find and check."}, {"id": "docs_04_brand_brand_kit_brand_line", "label": "Brand line: Screening you can trace", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_brand_kit_urdu_line", "label": "Urdu line: \u0630\u06c1\u0646 \u06a9\u06cc \u0628\u0627\u062a\u060c \u062b\u0628\u0648\u062a \u06a9\u06d2 \u0633\u0627\u062a\u06be (matters of the mind, with evidence)", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_brand_kit_brand_platform", "label": "Brand platform: Every conclusion has a point of origin", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L19", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_brand_kit_brand_character", "label": "Brand character: steady, exact, humane", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A modern clinical journal with a Lahore accent. Never: alarm, diagnosis talk, wellness fluff, glowing AI."}, {"id": "docs_04_brand_brand_kit_zaal_mark", "label": "Zaal mark (Kufic \u0630 with saffron nuqta)", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One broad-nib stroke (stem + base) with a diamond nuqta above. Reads three ways: first letter of zehen, a corner framing a point of focus (behavioural imaging), and nuqta-e-nazar (a point of view)."}, {"id": "docs_04_brand_brand_kit_mark_construction", "label": "Mark construction (45\u00b0 symmetry, 24\u00b0 nib cuts, 11-unit stroke)", "file_type": "rationale", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mark mirrors across the y=x diagonal in a 64-unit drawing; stem and base are one reflected stroke; terminals cut at 24\u00b0 as if drawn by one broad pen; stem is four strokes tall, measured like a letter in nuqtas; nuqta is a 13-unit 45\u00b0 diamond centred at (26,26)."}, {"id": "docs_04_brand_brand_kit_nuqta_diamond", "label": "Saffron diamond nuqta", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L36", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_brand_kit_wordmark", "label": "Wordmark (outlined Newsreader Medium, 72 pt optical size)", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Outlined to vector paths with native kerning and -0.018 em tracking so files need no installed font and render identically everywhere. In the lockup the mark is 1.2x cap height with a 0.26 em gap."}, {"id": "docs_04_brand_brand_kit_logo_rules", "label": "Logo usage rules (clear space, minimum size, don'ts)", "file_type": "rationale", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Half a nuqta clear space around the mark, one nuqta around lockups; mark min 16 px, lockup min 96 px. Nuqta stays saffron in every colour version; moving it (e.g. below the letter) makes a different letter. No rotate/outline/stretch/gradients/glow; never inside a brain, head or speech bubble."}, {"id": "docs_04_brand_logo_zehensync_mark", "label": "zehensync-mark.svg (default)", "file_type": "image", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L43", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_logo_zehensync_mark_ink", "label": "zehensync-mark-ink.svg", "file_type": "image", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L44", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_logo_zehensync_mark_reversed", "label": "zehensync-mark-reversed.svg", "file_type": "image", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L45", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_logo_zehensync_mark_mono", "label": "zehensync-mark-mono.svg (currentColor)", "file_type": "image", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L46", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_logo_zehensync_lockup", "label": "zehensync-lockup.svg (primary horizontal lockup)", "file_type": "image", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_logo_zehensync_lockup_reversed", "label": "zehensync-lockup-reversed.svg", "file_type": "image", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_logo_zehensync_lockup_stacked", "label": "zehensync-lockup-stacked.svg", "file_type": "image", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L49", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_logo_zehensync_app_icon", "label": "zehensync-app-icon.svg (favicon, app tile, avatar)", "file_type": "image", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L50", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_brand_kit_rejected_logo_studies", "label": "Rejected logo concepts B (split lens), C (Z-trace), D (two minds)", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L51", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_brand_kit_colour_system", "label": "Colour system and screen proportion (paper 60 / mist 18 / ink 12 / neel 8 / saffron 2)", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L63", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_brand_kit_neel", "label": "Neel brand colour (#26318A)", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Neel is the indigo of Sindh's ajrak cloth; used for brand, primary actions, links, citations and focus (11.1:1 on white)."}, {"id": "docs_04_brand_brand_kit_saffron", "label": "Saffron point of attention (#E3A33B)", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marks one point per screen the way the nuqta marks one letter. Fills only, never text (2.2:1); saffron-700 #8A5A0E is the text-safe variant."}, {"id": "docs_04_brand_brand_kit_core_colour_tokens", "label": "Core colour tokens (neel, ink, graphite, slate, line, mist, paper, saffron)", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L69", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_brand_kit_severity_tokens", "label": "Severity tokens (steady, watch, urgent, crisis)", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L88", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Psychologist and admin screens only. Every state pairs colour with a shape (ring, triangle, diamond, dot) and a word, so meaning never depends on colour alone."}, {"id": "docs_04_brand_brand_kit_patients_never_see_severity", "label": "Patients never see severity colours", "file_type": "rationale", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L97", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Patient results use ink and neel only and the crisis screen stays calm white, avoiding alarm on patient-facing surfaces."}, {"id": "docs_04_brand_brand_kit_dark_brand_theme", "label": "Dark brand and dark theme (night palette)", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L99", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_brand_kit_newsreader", "label": "Newsreader (display and reading serif)", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L115", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_brand_kit_schibsted_grotesk", "label": "Schibsted Grotesk (interface)", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L116", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_brand_kit_geist_mono", "label": "Geist Mono (data)", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L117", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_brand_kit_noto_nastaliq_urdu", "label": "Noto Nastaliq Urdu (post-FYP)", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L118", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_brand_kit_type_scale", "label": "Type scale (13-64 px) and line heights", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L120", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_brand_kit_iconography", "label": "Custom icon set (24 px grid, 1.75 stroke, nuqta detail)", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L122", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Square ends and mitred corners match the mark's cut terminals; icons with a point of focus carry a small nuqta that turns saffron when active. No brains, lightbulbs, robots or sparkles."}, {"id": "docs_04_brand_brand_kit_lucide", "label": "Lucide icons (fallback at 1.75 stroke)", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L127", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_icons_check_in", "label": "check-in icon", "file_type": "image", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L126", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_icons_trace", "label": "trace icon", "file_type": "image", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L126", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_icons_flag", "label": "flag icon", "file_type": "image", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L126", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_icons_gaze", "label": "gaze icon", "file_type": "image", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L126", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_icons_blink", "label": "blink icon", "file_type": "image", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L126", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_icons_voice", "label": "voice icon", "file_type": "image", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L126", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_icons_citation", "label": "citation icon", "file_type": "image", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L126", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_icons_help_now", "label": "help-now (phone) icon", "file_type": "image", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L126", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_brand_kit_nuqta_jaali", "label": "Nuqta jaali pattern", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L131", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lattice of diamonds (26 px cell, white at 13-16% on neel) with at most two saffron nuqtas; brand surfaces only (covers, cards, decks, social, login backdrop), never behind patient questions, results or the crisis screen."}, {"id": "docs_04_brand_brand_kit_halftone_image_direction", "label": "Single-ink neel halftone image direction", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L132", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lahore architecture, arcades, jaali screens, horizons; saffron sun is the only second colour. Avoid stock photos of distress, AI faces, brains/neurons, glowing networks, real patients."}, {"id": "docs_04_brand_brand_kit_motion_system", "label": "Motion timings and easing (cubic-bezier 0.2, 0, 0, 1)", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L135", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Quiet by default with one signature moment: hover 120 ms, panels 200 ms, page 320 ms, crisis 150 ms fade only, reduced motion opacity only at 120 ms or less."}, {"id": "docs_04_brand_brand_kit_nuqta_lands_motion", "label": "Nuqta lands on the mark (check-in complete, 560 ms)", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L139", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_brand_kit_crisis_screen", "label": "Crisis screen (calm white, fade only)", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L143", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_brand_kit_voice_and_tone", "label": "Voice and tone (thoughtful clinician)", "file_type": "rationale", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L146", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Write like a thoughtful clinician to someone they respect: short sentences, plain words, no exclamation marks. Results describe answers, never diagnose; no-evidence answers say so; psychologist copy states numbers not impressions."}, {"id": "docs_04_brand_brand_kit_banned_words", "label": "Banned words (journey, dive in, unlock, empower, seamless, AI-powered...)", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L160", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_brand_kit_anti_slop_checklist", "label": "Anti-slop checklist", "file_type": "rationale", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L162", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A screen, deck or page ships only when every box holds: no gradients/glass/neon, no three-card icon rows, no emoji, one saffron point max, real or labelled demo numbers, images that explain only-ZehenSync things, three typefaces only, no distress stock/AI faces/brains, mark as drawn, copy passes the voice table."}, {"id": "docs_04_brand_brand_kit_mockup_placeholders", "label": "Mockup placeholders and fictional demo data (zehensync.app, Hira M., Dr. A. Khan, Sana)", "file_type": "concept", "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L177", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "zehensync.app is an unregistered placeholder domain; names in mockups are fictional demo data."}], "edges": [{"source": "docs_04_brand_brand_kit", "target": "docs_03_design_design_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L9", "weight": 1.0}, {"source": "docs_04_brand_brand_kit", "target": "docs_00_home_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L9", "weight": 1.0}, {"source": "docs_04_brand_brand_kit", "target": "docs_04_brand_tokens", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/04-Brand/Brand-Kit.md", "source_location": "L9", "weight": 1.0}, {"s