{"nodes": [{"id": "docs_04_brand_logo_zehensync_mark", "label": "ZehenSync mark (primary)", "file_type": "image", "source_file": "docs/04-Brand/logo/zehensync-mark.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Master mark: neel Zaal glyph (upright stem plus base) with a saffron diamond nuqta; every other logo asset reuses its exact path geometry."}, {"id": "docs_04_brand_logo_zehensync_mark_zaal_mark", "label": "Zaal mark (Kufic Urdu letter \u0630)", "file_type": "concept", "source_file": "docs/04-Brand/logo/zehensync-mark.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Angular Kufic rendering of \u0630 (Zaal): an upright stem joined to a flat base, with the letter's single dot as a saffron diamond. \u0630 is the initial of \u0630\u06c1\u0646 (zehen, 'mind'), so the glyph spells the first letter of the product name (inferred). Chosen over the rejected studies B-D."}, {"id": "docs_04_brand_logo_zehensync_mark_nuqta_diamond", "label": "Nuqta diamond motif", "file_type": "rationale", "source_file": "docs/04-Brand/logo/zehensync-mark.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The dot (nuqta) of \u0630 drawn as a 45-degree square in saffron. It is the one element common to the final mark, all three rejected studies and six of the thirteen UI icons, so it works as the brand's portable signature."}, {"id": "docs_04_brand_logo_zehensync_mark_neel_26318a", "label": "Neel #26318A (brand colour)", "file_type": "concept", "source_file": "docs/04-Brand/logo/zehensync-mark.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_04_brand_logo_zehensync_mark_saffron_e3a33b", "label": "Saffron #E3A33B (nuqta accent)", "file_type": "concept", "source_file": "docs/04-Brand/logo/zehensync-mark.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept constant across neel, ink, reversed and app-icon colourways; dropped only in the single-colour mono mark."}], "edges": [{"source": "docs_04_brand_logo_zehensync_mark", "target": "docs_04_brand_logo_zehensync_mark_zaal_mark", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/04-Brand/logo/zehensync-mark.svg", "source_location": null, "weight": 1.0}, {"source": "docs_04_brand_logo_zehensync_mark", "target": "docs_04_brand_logo_zehensync_mark_nuqta_diamond", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/04-Brand/logo/zehensync-mark.svg", "source_location": null, "weight": 1.0}, {"source": "docs_04_brand_logo_zehensync_mark", "target": "docs_04_brand_logo_zehensync_mark_neel_26318a", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/04-Brand/logo/zehensync-mark.svg", "source_location": null, "weight": 1.0}, {"source": "docs_04_brand_logo_zehensync_mark", "target": "docs_04_brand_logo_zehensync_mark_saffron_e3a33b", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/04-Brand/logo/zehensync-mark.svg", "source_location": null, "weight": 1.0}, {"source": "docs_04_brand_logo_zehensync_mark_zaal_mark", "target": "docs_04_brand_logo_zehensync_mark_nuqta_diamond", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/04-Brand/logo/zehensync-mark.svg", "source_location": null, "weight": 1.0}, {"source": "docs_04_brand_logo_zehensync_mark_zaal_mark", "target": "docs_04_brand_logo_zehensync_mark_neel_26318a", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/04-Brand/logo/zehensync-mark.svg", "source_location": null, "weight": 1.0}, {"source": "docs_04_brand_logo_zehensync_mark_nuqta_diamond", "target": "docs_04_brand_logo_zehensync_mark_saffron_e3a33b", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/04-Brand/logo/zehensync-mark.svg", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "docs_04_brand_logo_zaal_mark_colourways", "label": "Zaal mark colourway family (shared glyph geometry)", "nodes": ["docs_04_brand_logo_zehensync_mark", "docs_04_brand_logo_zehensync_mark_ink", "docs_04_brand_logo_zehensync_mark_mono", "docs_04_brand_logo_zehensync_mark_reversed", "docs_04_brand_logo_zehensync_app_icon", "docs_04_brand_logo_zehensync_mark_zaal_mark"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/04-Brand/logo/zehensync-mark.svg"}]}