ured_at": null, "author": null, "contributor": null, "rationale": "Minors get resources and no account; patients must be 18+."}, {"id": "docs_03_design_app_flow_patient_consent", "label": "Patient Consent (terms, screening disclaimer, AI processing)", "file_type": "concept", "source_file": "docs/03-Design/App-Flow.md", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_03_design_app_flow_clinician_verification_flow", "label": "Clinician Verification and 2FA Setup", "file_type": "concept", "source_file": "docs/03-Design/App-Flow.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clinician signup requires licence and proof upload, waits on admin approval, then mandatory 2FA before reaching the queue."}, {"id": "docs_03_design_app_flow_sdoh_intake", "label": "SDOH Intake", "file_type": "concept", "source_file": "docs/03-Design/App-Flow.md", "source_location": "L59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One question per view with 4-6 options and 'Prefer not to say'; progress shown as '3 of 7' not a percentage bar; answers autosave and back always works; incomplete intakes resume at the last answered question."}, {"id": "docs_03_design_app_flow_patient_sitemap", "label": "Patient Sitemap", "file_type": "concept", "source_file": "docs/03-Design/App-Flow.md", "source_location": "L43", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_03_design_app_flow_guided_volition_runner", "label": "Guided Volition Runner (check-in state machine)", "file_type": "concept", "source_file": "docs/03-Design/App-Flow.md", "source_location": "L70", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 1 s 'Adding up your answers' pause after the last item is deliberate: scoring is instant, but the pause lets the transition read as deliberate."}, {"id": "docs_03_design_app_flow_camera_calibration", "label": "Camera Calibration (20 s baseline)", "file_type": "concept", "source_file": "docs/03-Design/App-Flow.md", "source_location": "L75", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_03_design_app_flow_safety_check_state", "label": "SafetyCheck State", "file_type": "concept", "source_file": "docs/03-Design/App-Flow.md", "source_location": "L79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_03_design_app_flow_safety_pathway", "label": "Safety Pathway (moderate signal)", "file_type": "concept", "source_file": "docs/03-Design/App-Flow.md", "source_location": "L81", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_03_design_app_flow_cssrs_escalation", "label": "C-SSRS Escalation Step", "file_type": "concept", "source_file": "docs/03-Design/App-Flow.md", "source_location": "L83", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_03_design_app_flow_hard_stop", "label": "Hard Stop (high signal)", "file_type": "concept", "source_file": "docs/03-Design/App-Flow.md", "source_location": "L82", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_03_design_app_flow_item_view_layout", "label": "Check-in Item View Layout", "file_type": "concept", "source_file": "docs/03-Design/App-Flow.md", "source_location": "L93", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Timeframe line, large rephrased question with 'Show original wording' link, 56 px full-width answers with keyboard keys, optional note, footer with progress and camera dot."}, {"id": "docs_03_design_app_flow_result_view", "label": "Plain-Language Result View", "file_type": "concept", "source_file": "docs/03-Design/App-Flow.md", "source_location": "L103", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Headline uses Instruments band wording; single band bar; score shown small ('Score 12 of 27'); 2-3 next actions."}, {"id": "docs_03_design_app_flow_counselor_chat", "label": "Counselor Chat", "file_type": "concept", "source_file": "docs/03-Design/App-Flow.md", "source_location": "L110", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Assistant messages have no avatar bubble and read as text on the page; ending a chat invites an optional note."}, {"id": "docs_03_design_app_flow_voice_input_flow", "label": "Voice Input (hold-to-talk, transcript confirm)", "file_type": "concept", "source_file": "docs/03-Design/App-Flow.md", "source_location": "L118", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_03_design_app_flow_crisis_hard_stop_409", "label": "409 CRISIS_HARD_STOP Response", "file_type": "concept", "source_file": "docs/03-Design/App-Flow.md", "source_location": "L125", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_03_design_app_flow_instrument_suggestion_card", "label": "Instrument Suggestion Card", "file_type": "concept", "source_file": "docs/03-Design/App-Flow.md", "source_location": "L129", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_03_design_app_flow_sharing_flow", "label": "Psychologist Sharing Flow (invite code, confirm, revoke)", "file_type": "concept", "source_file": "docs/03-Design/App-Flow.md", "source_location": "L140", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_03_design_app_flow_sharing_scopes", "label": "Sharing Scopes", "file_type": "concept", "source_file": "docs/03-Design/App-Flow.md", "source_location": "L144", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scopes: name and contact, scores, how answers led to fla